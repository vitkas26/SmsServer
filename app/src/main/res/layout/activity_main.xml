<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/serverStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/server_stopped" />

    <TextView
        android:id="@+id/serverAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/server_address" />

    <TextView
        android:id="@+id/gatewayToken"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true" />

    <Button
        android:id="@+id/toggleServer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/start" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/routes_title" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:labelFor="@id/sim1Phone"
        android:text="@string/sim1_phone" />

    <EditText
        android:id="@+id/sim1Phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/sim1_phone"
        android:inputType="phone"
        android:maxLines="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:labelFor="@id/sim2Phone"
        android:text="@string/sim2_phone" />

    <EditText
        android:id="@+id/sim2Phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/sim2_phone"
        android:inputType="phone"
        android:maxLines="1" />

    <Button
        android:id="@+id/saveRoutes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/save_routes" />

    <Button
        android:id="@+id/operatorCodes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/operator_codes" />

    <TextView
        android:id="@+id/routeStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/routes_hint" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/startDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/from_date" />
        <Button
            android:id="@+id/endDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/to_date" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/inboxButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/inbox" />
        <Button
            android:id="@+id/sentButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sent" />
    </LinearLayout>

    <TextView
        android:id="@+id/emptyMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/no_messages" />

    <ListView
        android:id="@+id/messageList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
